{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teacheros.local/schemas/day04/lesson-plan-v1.json",
  "title": "TeacherOS evaluated lesson plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "output_type", "cefr_level", "lesson_duration_minutes", "objectives", "sections", "questions", "answer_key", "assessment_objective_ids", "evidence_traceability", "claims", "teacher_approval", "limitations", "injection_handling"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^D4-[0-9]{3}$"},
    "output_type": {"const": "lesson_plan"},
    "cefr_level": {"enum": ["A1", "A2", "B1", "B2", "C1"]},
    "lesson_duration_minutes": {"type": "integer", "minimum": 10, "maximum": 180},
    "objectives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/objective"}},
    "sections": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/section"}},
    "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}},
    "answer_key": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/answer"}},
    "assessment_objective_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_traceability": {"type": "array", "items": {"$ref": "#/$defs/trace"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "teacher_approval": {"$ref": "#/$defs/approval"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 240}},
    "injection_handling": {"enum": ["not_applicable", "ignored_as_untrusted_data"]}
  },
  "$defs": {
    "objective": {"type":"object","additionalProperties":false,"required":["id","text"],"properties":{"id":{"type":"string"},"text":{"type":"string","minLength":3,"maxLength":240}}},
    "section": {"type":"object","additionalProperties":false,"required":["section_type","title","duration_minutes","objective_ids","teacher_steps","learner_steps","materials"],"properties":{"section_type":{"enum":["warm_up","model","guided_practice","independent_practice","assessment","closure","adaptation"]},"title":{"type":"string"},"duration_minutes":{"type":"integer","minimum":1},"objective_ids":{"type":"array","items":{"type":"string"}},"teacher_steps":{"type":"array","minItems":1,"items":{"type":"string"}},"learner_steps":{"type":"array","minItems":1,"items":{"type":"string"}},"materials":{"type":"array","items":{"type":"string"}}}},
    "question": {"type":"object","additionalProperties":false,"required":["id","kind","prompt","options","answer"],"properties":{"id":{"type":"string"},"kind":{"enum":["multiple_choice","short_answer","matching","true_false"]},"prompt":{"type":"string"},"options":{"type":"array","items":{"type":"string"}},"answer":{"type":"string"}}},
    "answer": {"type":"object","additionalProperties":false,"required":["question_id","answer","rationale"],"properties":{"question_id":{"type":"string"},"answer":{"type":"string"},"rationale":{"type":"string"}}},
    "trace": {"type":"object","additionalProperties":false,"required":["claim_id","evidence_ids"],"properties":{"claim_id":{"type":"string"},"evidence_ids":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "claim": {"type":"object","additionalProperties":false,"required":["claim_id","text","claim_type","status","confidence"],"properties":{"claim_id":{"type":"string"},"text":{"type":"string"},"claim_type":{"enum":["observation","teaching_hypothesis","high_stakes_grade","diagnosis","mastery","learner_grouping"]},"status":{"enum":["proposal","teacher_approved","rejected"]},"confidence":{"enum":["low","medium","high"]}}},
    "approval": {"type":"object","additionalProperties":false,"required":["required","status"],"properties":{"required":{"const":true},"status":{"enum":["pending","approved","rejected"]}}}
  }
}
